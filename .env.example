# ── z8run environment ──────────────────────────────────────
# Copy to .env and adjust for your deployment

# Database (local dev uses SQLite by default)
Z8_DB_URL=postgres://z8run:z8run_secret@localhost:5432/z8run
Z8_PORT=7700
Z8_LOG_LEVEL=info
Z8_BIND=0.0.0.0
Z8_DATA_DIR=./data

# ── Docker deployment ─────────────────────────────────────
# Password for the z8run PostgreSQL user
POSTGRES_PASSWORD=z8run_secret

# JWT signing secret (REQUIRED for PostgreSQL/MySQL, auto-generated for SQLite dev)
# Generate with: openssl rand -base64 32
Z8_JWT_SECRET=change-me-in-production

# Encryption key for credential vault (MUST change in production!)
Z8_VAULT_SECRET=change-me-in-production

# Public port - use 80 behind Cloudflare, 8080 for local dev
Z8_PUBLIC_PORT=80

# ── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed browser origins. When set, CORS is
# restricted to exactly these origins. When unset, CORS is permissive
# (convenient for local dev) and a warning is logged at startup.
# Example: Z8_CORS_ORIGINS=https://app.example.com,https://admin.example.com
Z8_CORS_ORIGINS=

# ── Rate limiting ────────────────────────────────────────
# Requests per window per IP (token bucket). Set 0 to disable a limiter.
Z8_RATE_LIMIT_API=100
Z8_RATE_LIMIT_AUTH=20
Z8_RATE_LIMIT_HOOK=200
Z8_RATE_LIMIT_WINDOW=60
